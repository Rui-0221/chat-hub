# FastAPI
APP_NAME=Chat Hub API
APP_VERSION=0.2.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQL_ECHO=false

# AI providers
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_EMBEDDING_MODEL=bge-m3

# Optional storage overrides. Defaults live in backend/data/.
# DATABASE_URL=sqlite+aiosqlite:///./data/chat.db
# CHAT_HUB_DATA_DIR=C:/absolute/path/to/data
# CHROMA_DIRECTORY=C:/absolute/path/to/chroma_db
# CHROMA_COLLECTION=handbook
# HANDBOOK_PATH=C:/absolute/path/to/handbook.md
